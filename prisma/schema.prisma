// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model Club {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  events    Event[]
  followers HubFollow[]
  blocks    HubBlock[]
  members   ClubMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      EventStatus @default(DRAFT)
  date        DateTime
  capacity    Int
  location    String
  imageUrl    String
  clubId      Int
  authorId    String
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id])
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rsvps       RSVP[]
  discussionThreads EventDiscussionThread[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Metadata/Personalization fields
  category       String?
  tags           String[]
  domain         String?
  isFreeFood     Boolean   @default(false)
  hasCertificate Boolean   @default(false)
  isPaid         Boolean   @default(false)
  targetBranches String[]

  @@index([date])
  @@index([clubId])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  role           Role            @default(STUDENT)
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  password       String? // hashed — only set for credentials-based accounts
  collegeId      String
  college        College         @relation(fields: [collegeId], references: [id])
  studentProfile StudentProfile?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  authoredEvents Event[]
  rsvps          RSVP[]
  authoredDiscussionThreads EventDiscussionThread[]
  authoredDiscussionReplies EventDiscussionReply[]
  followedHubs   HubFollow[]
  clubMemberships ClubMembership[]
}

model EventDiscussionThread {
  id        Int      @id @default(autoincrement())
  eventId   Int
  authorId  String
  question  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author  User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies EventDiscussionReply[]

  @@index([eventId, pinned, createdAt])
  @@index([authorId])
}

model EventDiscussionReply {
  id        Int      @id @default(autoincrement())
  threadId  Int
  authorId  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread EventDiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

model ClubMembership {
  userId    String
  clubId    Int
  role      ClubRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
  @@index([userId])
}

model HubFollow {
  userId    String
  clubId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

model HubBlock {
  id        Int          @id @default(autoincrement())
  clubId    Int
  type      HubBlockType
  title     String?
  content   String
  linkUrl   String?
  position  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, position])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RSVP {
  id        Int        @id @default(autoincrement())
  userId    String
  eventId   Int
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

model College {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  emailDomains String[]
  logoUrl      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  users           User[]
  clubs           Club[]
  events          Event[]
  studentProfiles StudentProfile[]
}

model StudentProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId              String
  college                College   @relation(fields: [collegeId], references: [id])
  prn                    String
  branch                 String
  course                 String
  graduationYear         Int
  section                String?
  phone                  String?
  isVerified             Boolean   @default(false)
  lockedAt               DateTime?
  
  // Permanent Student QR Identity
  studentQrId            String?   @unique
  studentQrSecretVersion Int       @default(1)
  qrRevokedAt            DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([collegeId, prn])
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
  SUPER_ADMIN
}

enum EventStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
  CANCELLED
}

enum RSVPStatus {
  GOING
  WAITLISTED
  CANCELLED
  ATTENDED
}

enum ClubRole {
  OWNER
  EDITOR
}

enum HubBlockType {
  TEXT
  RESOURCE
  FAQ
}
