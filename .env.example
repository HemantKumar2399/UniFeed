# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Google Provider
# Create credentials at: https://console.developers.google.com/
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Domain Restriction
# Comma-separated list of allowed email domains (no @ prefix)
# Example: "students.college.edu,faculty.college.edu"
ALLOWED_DOMAINS="students.college.edu"

# Dedicated signing secret for permanent student QR tokens.
# Keep this distinct from AUTH_SECRET so QR rotation can be managed independently.
STUDENT_QR_SECRET=""

# Optional explicit app origin for deployments outside Vercel.
# Leave blank for local development.
NEXT_PUBLIC_APP_URL=""

# Optional public base URL for uploaded files.
# Example: "https://cdn.your-campus.edu/uploads"
UPLOAD_PUBLIC_BASE_URL=""

# Optional object storage settings for direct organizer uploads.
# If these are blank, organizers can still paste a hosted image URL manually.
UPLOAD_BUCKET_NAME=""
UPLOAD_REGION=""
UPLOAD_ACCESS_KEY_ID=""
UPLOAD_SECRET_ACCESS_KEY=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/Platform"

# Testing Variables
TEST_ENV=local
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api
