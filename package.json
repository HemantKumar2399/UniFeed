{
  "name": "unifeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx --env-file=.env prisma/seed.ts",
    "db:start": "node scripts/start-database.mjs",
    "db:start:windows": "node scripts/start-database.mjs",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint --max-warnings=0 src tests prisma/seed.ts src/env.js playwright.config.ts eslint.config.js next.config.js postcss.config.js prettier.config.js",
    "lint:fix": "eslint --fix --max-warnings=0 src tests prisma/seed.ts src/env.js playwright.config.ts eslint.config.js next.config.js postcss.config.js prettier.config.js",
    "preview": "next build && next start",
    "setup": "node scripts/setup-local.mjs",
    "setup:windows": "node scripts/setup-local.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-e2e-smoke.ts && playwright test",
    "test:e2e:smoke": "node --env-file-if-exists=.env --import tsx scripts/bootstrap-e2e-smoke.ts && playwright test --project=chromium --workers=1 tests/e2e/epic16-smoke.spec.ts tests/e2e/epic17-realtime.spec.ts",
    "test:unit": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs --integration"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^6.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.99.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.16.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.474.0",
    "next": "15.5.18",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.72.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.20.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.6.2"
}
